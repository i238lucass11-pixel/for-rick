"""
Portfolio_Balancer.py
=====================
Builds a multi-asset, multi-sleeve portfolio entirely point-in-time (no look-ahead).

ARCHITECTURE OVERVIEW
---------------------
The portfolio is organized into thematic sleeves:
    CRYPTO, GROWTH_BETA, CYCLICAL_COMMODITY, DIVERSIFIERS
    (DEFENSIVE_QUALITY exists upstream but is excluded — see EXCLUDED_SLEEVES)

Each sleeve contains an ensemble of trend-following strategies mined by Optuna
and combined by the Assembler. The balancer allocates at two levels:

    Level 1 — INTRA-SLEEVE:  weights each ticker within a sleeve using its
              diversification score (point-in-time window). An inverse-vol
              term at this level was tested and removed — see
              compute_intra_weights() for the rationale.

    Level 2 — INTER-SLEEVE:  allocates across sleeves with inverse-volatility
              weights on a Ledoit-Wolf shrunk covariance, subject to hard
              per-sleeve caps (SLEEVE_CAPS). This is genuine risk-parity
              across asset classes with very different risk profiles.

RISK CONTROLS
-------------
  - VIX de-risk gate: cuts gross exposure below 100% during extreme VIX
    stress (uses prior-day VIX — no look-ahead). Active in the official
    configuration; isolated sweep showed it improves Sharpe/MaxDD/Calmar
    at no CAGR cost.
  - Leverage (optional): vol-targeting + regime gate, max gross =
    MAX_LEVERAGE. Kept as a configuration knob but OFF in the official
    config (MAX_LEVERAGE = 1.0): sweeping 1.15x/1.30x/1.50x degraded
    CAGR, Sharpe and MaxDD monotonically (5% borrow + procyclical timing).
  - Transaction costs: turnover cost on rebalance days plus daily CFD
    swap/financing on held positions, per broker (see broker_config.py).

VALIDATION RESULTS (July 2026, full 291-ticker universe, OOS matrix)
--------------------------------------------------------------------
  - Official portfolio 2016–2026: CAGR 6.59%, Sharpe 0.97, MaxDD -11.7%.
  - Walk-forward (2-yr rolling windows from 2019): mean Sharpe 1.28,
    10/12 windows positive; the two negative windows center on the 2022
    crypto/rates bear market.
  - Monte Carlo (block bootstrap, 2000 simulations): the realized result
    sits at the 51st percentile — typical, not lucky. Plan for the 5th
    percentile MaxDD of -14.9%, not the historical best-case path.
  - IS/OOS Sharpe gap +1.04: the mining stage overfits (expected by
    construction); the OOS is the realistic expectation and holds up.

INPUTS
------
    ensemble_per_ticker.csv          — one row per ticker, with sleeve, Sharpe, CAGR
    ensemble_returns_long.*          — long-format daily returns (ticker × date)
    sleeve_map.json                  — maps tickers to sleeves
    sector_map.json (optional)       — fallback sector → sleeve mapping
    Internet (yfinance)              — SPY, VIX, HYG, LQD prices for the regime signal

OUTPUTS
-------
    portfolio_weights.csv            — final weights per ticker
    portfolio_equity.*               — equity curve + drawdown + gross exposure
    sleeve_equity_curves.*           — equal-weight equity per sleeve (for charts)
    regime_series.*                  — daily regime score
    portfolio_report.txt             — human-readable performance report

Run: py Portfolio_Balancer.py
"""

import os
import json
import warnings
import numpy as np
import pandas as pd

warnings.filterwarnings('ignore')


# =============================================================================
# SECTION 1 — FILE PATHS
# =============================================================================

INPUT_ENSEMBLE = 'ensemble_per_ticker.csv'
INPUT_RETURNS  = 'ensemble_returns_long'
SLEEVE_MAP     = 'sleeve_map.json'

OUTPUT_WEIGHTS = 'portfolio_weights.csv'
OUTPUT_EQUITY  = 'portfolio_equity'
OUTPUT_SLEEVES = 'sleeve_equity_curves'
OUTPUT_REGIME  = 'regime_series'
OUTPUT_REPORT  = 'portfolio_report.txt'


# =============================================================================
# SECTION 2 — PORTFOLIO PARAMETERS
# =============================================================================

INIT_CASH   = 10_000
FREQ_ANNUAL = 252        # trading days per year

# Reindex all returns to business days so crypto (which trades on weekends)
# shares the same 252-day grid as equities and forex. Crypto weekend returns
# are compounded into the following Monday — no return is lost.
# Without this, crypto has ~365 rows/year and its volatility is underestimated
# relative to other assets, corrupting the inverse-vol allocation.
REINDEX_BDAYS = True

REBAL_FREQ  = 126        # official 2026-07: uniform semi-annual (was 63; a
                         # 9-offset phase test showed 126d uniform dominates)
REBAL_PHASE_OFFSET = 0   # shifts the rebalance grid N days (phase testing:
                         # with ~13 rebalances per backtest the result can
                         # depend on WHICH dates they fall on). The first
                         # rebalance is always at WARMUP_MIN regardless.
LOOKBACK    = 252        # rolling window length (days)
WARMUP_MIN  = 120        # minimum history before first rebalance
MIN_OBS_WIN = 60         # minimum non-NaN observations to include a ticker in the window

# Sleeve caps and floors (hard constraints, enforced at every rebalance)
SLEEVE_CAPS = {
    'CRYPTO':             0.25,
    'GROWTH_BETA':        0.80,   # raised from 0.40 (2026-07 sweep, 291-ticker
                                  # universe): 40% starved the sleeve with the
                                  # best standalone CAGR (~13%). Sweeping
                                  # 40->100% improves CAGR/Sharpe/Calmar
                                  # monotonically and saturates at 80%
                                  # (80/90/100% produce identical results —
                                  # the natural weight never hits the cap
                                  # above that).
    'DEFENSIVE_QUALITY':  None,   # no cap (sleeve excluded anyway)
    'DIVERSIFIERS':       0.30,   # cap added 2026-07: with no ceiling,
                                  # inverse-vol pushed ~50% into the lowest-vol
                                  # sleeve (forex) and starved GROWTH_BETA,
                                  # which has better standalone CAGR.
    'CYCLICAL_COMMODITY': 0.30,
    'SIN_SLEEVE':         0.05,
}
SLEEVE_MIN = 0.05


# =============================================================================
# SECTION 3 — PER-SLEEVE REBALANCE FREQUENCY
# =============================================================================
# Each sleeve can rebalance on its own schedule. On non-rebalance days a sleeve
# keeps its last weight; the portfolio is renormalized to 1.0 daily.

PER_SLEEVE_REBAL  = False  # official since the 2026-07 phase test: uniform
                           # 126d. The per-sleeve scheme below was calibrated
                           # on the old universe and kept only as reference.
REBAL_FREQ_SLEEVE = {
    'CRYPTO':             3,    # fast cycle; 1-2 days showed reversion (noise)
    'GROWTH_BETA':        63,
    'CYCLICAL_COMMODITY': 42,   # Calmar degrades at 21 days (slow macro cycles)
    'DEFENSIVE_QUALITY':  189,  # slow anchor
    'DIVERSIFIERS':       63,
}


# =============================================================================
# SECTION 4 — TRANSACTION COSTS (broker-differentiated model)
# =============================================================================
# Two components, per ticker:
#   1. turnover cost = Σ |Δw_ticker| × turnover_bps / 10000
#      Charged on rebalance days only (spread/commission on entry-exit).
#   2. swap cost = w_ticker × swap_annual / FREQ_ANNUAL
#      Charged EVERY DAY the position is held (CFD overnight financing).
#      Zero for Hapi (real positions) and Binance (spot); the dominant
#      cost for Vantage CFD positions held multiple days.
#
# See broker_config.py for the full broker classification and cost model.

APPLY_COSTS = True

# Set True to route tickers Hapi doesn't cover to Vantage as CFD instead of
# excluding them from the universe.
INCLUDE_NON_HAPI_AS_CFD = False

# ---------------------------------------------------------------------------
# FOREX SWAP: historical model + exotic-pair exclusion (validated 2026-07)
# ---------------------------------------------------------------------------
# 1. USE_HISTORICAL_FOREX_SWAP=True — the swap of each forex pair (=X) is
#    computed per date from forex_swap.py (historical policy-rate differential
#    + ~2.5% broker markup) instead of a flat 2%/yr. A pair's swap IS the rate
#    differential, which changes with every central-bank decision. Realized
#    forex drag is ~0.75%/yr (the flat model underestimated it at 0.58%).
#
# 2. EXCLUDE_FOREX_EXOTICS=True — USDBRL and USDMXN (long USD / short
#    high-rate EM currency) pay a strong persistent negative swap (+10% and
#    +7.5%/yr of drag with markup). They are the only two problematic pairs;
#    excluding them cuts drag to ~0.55%/yr and restores Sharpe/Calmar to
#    baseline with slightly better CAGR — a clean improvement with no loss
#    of diversification.
#
# Setting both False restores the previous behavior (flat swap, with exotics).
USE_HISTORICAL_FOREX_SWAP = True
EXCLUDE_FOREX_EXOTICS = True
FOREX_EXOTIC_TICKERS = {'USDBRL=X', 'USDMXN=X'}

# ---------------------------------------------------------------------------
# EXCLUDED SLEEVES
# ---------------------------------------------------------------------------
# DEFENSIVE_QUALITY: removed after a 48-config sweep. Every SIN-DEFENSIVE
# config beat its ALL-5 equivalent; it was the sleeve with the worst
# standalone Sharpe, and its dampening role is already covered by
# DIVERSIFIERS (removing THAT sleeve does hurt — those configs ranked last).
# Tickers are excluded from the full universe (sleeve map AND return matrix);
# validation.py inherits this automatically.
EXCLUDED_SLEEVES = {'DEFENSIVE_QUALITY'}


def apply_sleeve_exclusions(R, sleeve_of):
    """Removes excluded sleeves from the universe (map AND return matrix).

    Removing them only from sleeve_of is NOT enough: their tickers would
    remain in R.columns mapped to 'SIN_SLEEVE' and receive up to that cap (5%).
    """
    if not EXCLUDED_SLEEVES:
        return R, sleeve_of
    sleeve_of = {t: s for t, s in sleeve_of.items()
                 if s not in EXCLUDED_SLEEVES}
    R = R[[t for t in R.columns if t in sleeve_of]]
    return R, sleeve_of

# ---------------------------------------------------------------------------
# COMMODITY FUTURES: optional replacement by real ETFs (both flags OFF in the
# official config — kept for production-feasibility comparisons).
# ---------------------------------------------------------------------------
# Commodity futures (=F) route to Vantage as CFDs (flat estimated 6%/yr swap).
# Three of them have a live ETF equivalent already in the ensemble that routes
# to Hapi as a real position with NO swap:
#   GC=F (gold)   → GLD/GDX/GDXJ    SI=F (silver) → SLV    HG=F (copper) → REMX
EXCLUDE_COMMODITY_FUTURES_WITH_ETF = False
COMMODITY_FUTURES_WITH_ETF = {'GC=F', 'SI=F', 'HG=F'}

# The other 9 futures have no viable ETF (platinum, crude, agricultural).
# Excluding them shows the metrics of a portfolio 100% executable with
# Hapi + Binance + Vantage-forex, with no commodity futures at all.
EXCLUDE_COMMODITY_FUTURES_NO_ETF = False
COMMODITY_FUTURES_NO_ETF = {'PL=F', 'CL=F', 'ZS=F', 'ZC=F', 'ZW=F', 'ZL=F',
                             'KC=F', 'CC=F', 'CT=F'}

COST_BPS_DEFAULT = 5.0   # fallback when broker/asset_group is unknown


def experimental_exclusions(tickers):
    """
    Set of tickers excluded by the flags above (forex exotics + commodity
    futures). Centralized here so the balancer and validation.py exclude
    EXACTLY the same universe — otherwise validation would measure a
    different portfolio than the one the balancer builds.
    """
    universe = set(tickers)
    excl = set()
    if EXCLUDE_FOREX_EXOTICS:
        excl |= (FOREX_EXOTIC_TICKERS & universe)
    if EXCLUDE_COMMODITY_FUTURES_WITH_ETF:
        excl |= (COMMODITY_FUTURES_WITH_ETF & universe)
    if EXCLUDE_COMMODITY_FUTURES_NO_ETF:
        excl |= (COMMODITY_FUTURES_NO_ETF & universe)
    return excl


# =============================================================================
# SECTION 5 — LEVERAGE AND VIX GATES
# =============================================================================
# Vol-targeting leverage: gross exposure scales up when realized vol is below
# TARGET_VOL, subject to the regime gate (risk-on only) and the VIX cap.
# Vol estimated with EWMA (λ=0.94, RiskMetrics standard).
#
# OFF in the official config: the 2026-07 sweep (1.15x / 1.30x / 1.50x over
# the full 291-ticker universe) showed leverage degrades CAGR, Sharpe and
# MaxDD monotonically (5% borrow cost + procyclical timing). The machinery is
# kept as a documented knob; re-evaluate only with a fresh sweep.

MAX_LEVERAGE      = 1.00
TARGET_VOL        = 0.13   # annualized vol target when leverage is active
VOL_FLOOR         = 0.00   # anti-procyclical floor on the vol estimate used
                           # for leverage sizing (0.0 = off). Rationale: calm
                           # regimes (realized vol ~7%) can push gross to max
                           # right before a shock; a floor of 0.09-0.10 caps
                           # l_vol = TARGET/max(vol, floor). Sweep before use.
LEV_REGIME_MIN    = 0.60   # regime score must exceed this to allow leverage
BORROW_RATE_ANNUAL = 0.05  # annual financing cost on notional above 100%

# VIX gate (evaluated daily, uses prior-day VIX — no look-ahead).
# In the official config the gate runs standalone on the unlevered portfolio:
# the isolated sweep (2026-07, full universe) showed +Sharpe, +Calmar and
# -2.3pp MaxDD at unchanged CAGR.
VIX_GATE  = True
VIX_LOW   = 20.0    # below this: full leverage allowed
VIX_HIGH  = 35.0    # above this: leverage capped at 1.0×

# De-risk gate: cuts gross below 100% during extreme VIX stress.
# Active even when MAX_LEVERAGE = 1.0.
DERISK_GATE      = True
DERISK_VIX_START = 30.0    # start cutting gross here
DERISK_VIX_FULL  = 50.0    # maximum cut here
DERISK_FLOOR     = 0.70    # never go below 70% invested

# Informational only (report): trend score window per sleeve and regime smoothing.
SLEEVE_TREND_WIN  = 100
REGIME_SMOOTH     = 10
HIGH_BETA_SLEEVES = {'CRYPTO', 'GROWTH_BETA', 'CYCLICAL_COMMODITY'}  # report icons


# =============================================================================
# SECTION 6 — VOLATILITY ESTIMATOR (EWMA)
# =============================================================================
# Used for leverage vol-targeting and the de-risk gates.
#   'simple21' — flat 21-day std. Noisy; reacts late to vol shocks.
#   'ewma'     — exponentially weighted (λ=0.94, RiskMetrics). CURRENT DEFAULT.
#   'blend'    — α·EWMA_short + (1-α)·EWMA_long. Less whipsaw in V-recoveries.

VOL_ESTIMATOR   = 'ewma'
VOL_LAMBDA      = 0.94    # EWMA decay (higher = smoother, lower = more reactive)
VOL_BLEND_ALPHA = 0.60    # blend: weight on short EWMA
VOL_SHORT_SPAN  = 21
VOL_LONG_SPAN   = 63
VOL_MIN_OBS     = 22      # minimum observations before estimating (else use TARGET_VOL)


# =============================================================================
# SECTION 7 — OUTPUT FORMAT
# =============================================================================
try:
    import pyarrow  # noqa: F401
    FORMAT = 'parquet'
except ImportError:
    FORMAT = 'csv'


# =============================================================================
# SECTION 8 — UTILITY FUNCTIONS (weights and covariance)
# =============================================================================

def shrink_covariance(returns_df):
    """
    Ledoit-Wolf shrinkage covariance estimator.
    Falls back to a manual shrinkage (80% sample + 20% identity) if sklearn
    is unavailable. Returns None if insufficient data.
    """
    X = returns_df.dropna()
    if len(X) < 20 or X.shape[1] == 0:
        return None
    try:
        from sklearn.covariance import LedoitWolf
        lw = LedoitWolf().fit(X.values)
        return pd.DataFrame(lw.covariance_, index=X.columns, columns=X.columns)
    except Exception:
        S = X.cov().values
        n = S.shape[0]
        mu = np.trace(S) / n
        Sh = 0.8 * S + 0.2 * (mu * np.eye(n))
        return pd.DataFrame(Sh, index=X.columns, columns=X.columns)


def inv_vol_from_cov(cov):
    """Inverse-vol weights from a covariance matrix (normalized to sum 1)."""
    vol = np.sqrt(np.clip(np.diag(cov.values), 1e-12, None))
    inv = 1.0 / vol
    return pd.Series(inv / inv.sum(), index=cov.index)


def apply_caps(weights, caps, floor):
    """
    Iteratively enforces per-sleeve caps and a minimum floor, renormalizing
    after each pass. Converges in at most 12 iterations.
    """
    w = weights.copy()
    for _ in range(12):
        w = w / w.sum()
        changed = False
        for s in w.index:
            cap = caps.get(s)
            if cap is not None and w[s] > cap + 1e-9:
                w[s] = cap
                changed = True
            if floor and 0 < w[s] < floor - 1e-9:
                w[s] = floor
                changed = True
        if not changed:
            break
    return w / w.sum()


def sleeve_trend_score(sleeve_returns):
    """
    Returns a 0..1 trend score for a sleeve using its equity curve relative to
    a rolling mean. Informational only (SLEEVE TREND SCORES section of the
    report) — it does not move weights.
    """
    r = sleeve_returns.dropna()
    if len(r) < 30:
        return 0.5
    eq = (1 + r).cumprod()
    w = min(len(eq), SLEEVE_TREND_WIN)
    ma = eq.rolling(w).mean().iloc[-1]
    if not np.isfinite(ma) or ma <= 0:
        return 0.5
    trend = eq.iloc[-1] / ma - 1.0
    return float(np.clip(0.5 + 0.5 * trend / 0.08, 0, 1))


def compute_gross_exposure(target_gross, vix_value, realized_vol=None):
    """
    Computes the actual daily gross exposure after applying:
      1. VIX leverage cap: cuts the levered portion when VIX is elevated.
      2. VIX de-risk: pushes gross below 1.0 during extreme stress.
    Returns target_gross unchanged if no risk signals are available.
    """
    g = target_gross
    has_vix = VIX_GATE and (vix_value is not None) and np.isfinite(vix_value)

    if has_vix and g > 1.0:
        gate = np.clip((VIX_HIGH - vix_value) / (VIX_HIGH - VIX_LOW), 0.0, 1.0)
        g = 1.0 + (g - 1.0) * gate

    if has_vix and DERISK_GATE:
        d = np.clip((DERISK_VIX_FULL - vix_value) / (DERISK_VIX_FULL - DERISK_VIX_START),
                    0.0, 1.0)
        vix_floor = DERISK_FLOOR + (1.0 - DERISK_FLOOR) * d
        if vix_floor < 1.0:
            g = min(g, vix_floor)
    return float(g)


def estimate_vol(return_array, i):
    """
    Point-in-time annualized volatility estimate using return_array[:i]
    (yesterday's data — no look-ahead). Returns TARGET_VOL if insufficient data.
    """
    if i <= VOL_MIN_OBS:
        return TARGET_VOL
    ret = pd.Series(return_array[:i])
    if VOL_ESTIMATOR == 'simple21':
        s = float(ret.iloc[-VOL_SHORT_SPAN:].std())
    elif VOL_ESTIMATOR == 'ewma':
        span_eq = 2.0 / (1.0 - VOL_LAMBDA) - 1.0
        s = float(ret.ewm(span=span_eq, min_periods=VOL_MIN_OBS).std().iloc[-1])
    elif VOL_ESTIMATOR == 'blend':
        s_short = float(ret.ewm(span=VOL_SHORT_SPAN, min_periods=VOL_MIN_OBS).std().iloc[-1])
        s_long  = float(ret.ewm(span=VOL_LONG_SPAN,  min_periods=VOL_MIN_OBS).std().iloc[-1])
        s = VOL_BLEND_ALPHA * s_short + (1.0 - VOL_BLEND_ALPHA) * s_long
    else:
        raise ValueError(f"Unknown VOL_ESTIMATOR: {VOL_ESTIMATOR!r}")
    if not np.isfinite(s) or s <= 0:
        return TARGET_VOL
    return float(s * np.sqrt(FREQ_ANNUAL))


def leverage_factor(regime_score, realized_vol):
    """
    Target gross exposure from vol-targeting + regime gate.
    Only activates when MAX_LEVERAGE > 1.0. Daily VIX adjustment is applied
    separately in compute_gross_exposure().
    """
    if MAX_LEVERAGE <= 1.0:
        return 1.0
    regime_gate = np.clip((regime_score - LEV_REGIME_MIN) /
                          max(1e-6, 1 - LEV_REGIME_MIN), 0, 1)
    l_vol = TARGET_VOL / max(realized_vol, VOL_FLOOR, 1e-6)
    extra = (np.clip(l_vol, 1.0, MAX_LEVERAGE) - 1.0) * regime_gate
    return float(np.clip(1.0 + extra, 1.0, MAX_LEVERAGE))


def max_drawdown(equity_curve):
    if len(equity_curve) < 2:
        return 0.0
    peak = equity_curve.cummax()
    return float(((equity_curve - peak) / peak).min())


# =============================================================================
# SECTION 9 — MARKET REGIME SIGNAL
# =============================================================================

def compute_regime(dates):
    """
    Downloads SPY, VIX, HYG, LQD from yfinance and computes a composite
    market regime score (0 = full risk-off, 1 = full risk-on), smoothed with
    an EMA. Uses prior-day data throughout — fully point-in-time.

    Components and weights:
      SPY price / 200-day MA      → 0..1  (weight 0.45)
      VIX level                   → 0..1  (weight 0.30; clipped to [15, 30])
      HYG/LQD ratio vs 50-day MA  → 0..1  (weight 0.25)

    The regime score gates leverage (when active) and is reported. The VIX
    series it returns drives the de-risk gate.
    Falls back to neutral (0.5) if internet is unavailable.
    """
    neutral = pd.Series(0.5, index=dates)
    vix_na  = pd.Series(np.nan, index=dates)
    try:
        import yfinance as yf
        start = (dates.min() - pd.Timedelta(days=400)).strftime('%Y-%m-%d')
        end   = (dates.max() + pd.Timedelta(days=2)).strftime('%Y-%m-%d')

        def _close(ticker):
            d = yf.download(ticker, start=start, end=end, interval='1d', progress=False)
            if d is None or len(d) < 200:
                return None
            c = d['Close']
            return c.squeeze() if hasattr(c, 'squeeze') else c

        spy = _close('SPY')
        vix = _close('^VIX')
        hyg = _close('HYG')
        lqd = _close('LQD')

        if spy is None:
            print("  ⚠  Regime: no market data available → neutral.")
            return neutral, vix_na

        components, weights = [], []

        ma200 = spy.rolling(200).mean()
        s_trend = 0.5 + 0.5 * np.clip((spy / ma200 - 1) / 0.10, -1, 1)
        components.append(s_trend); weights.append(0.45)

        if vix is not None:
            s_vix = np.clip((30 - vix) / (30 - 15), 0, 1)
            components.append(s_vix.reindex(spy.index).ffill()); weights.append(0.30)

        if hyg is not None and lqd is not None:
            ratio = hyg / lqd
            s_credit = 0.5 + 0.5 * np.clip((ratio / ratio.rolling(50).mean() - 1) / 0.02,
                                            -1, 1)
            components.append(s_credit.reindex(spy.index).ffill()); weights.append(0.25)

        weights = np.array(weights) / sum(weights)
        score = sum(p * w for p, w in zip(components, weights))
        score = score.ewm(span=REGIME_SMOOTH).mean().clip(0, 1)
        score.index = pd.to_datetime(score.index)
        regime_out = (score.reindex(dates.union(score.index))
                           .sort_index().ffill().reindex(dates).fillna(0.5))

        if vix is not None:
            vix.index = pd.to_datetime(vix.index)
            vix_out = (vix.reindex(dates.union(vix.index))
                          .sort_index().ffill().reindex(dates))
        else:
            vix_out = vix_na
        return regime_out, vix_out

    except Exception as e:
        print(f"  ⚠  Regime: error ({e}) → neutral.")
        return neutral, vix_na


# =============================================================================
# SECTION 10 — INTRA-SLEEVE WEIGHTS (Level 1 allocation)
# =============================================================================

def compute_intra_weights(window, sleeve_to_tickers, div_map):
    """
    Computes intra-sleeve weights for all tickers on the current rolling window.
    Each ticker's weight = diversification_score (NO inverse-vol term — see
    note below). Tickers with fewer than MIN_OBS_WIN non-NaN observations are
    excluded to avoid underestimating the volatility of recently-listed
    instruments (IPO bias).

    Inverse-vol removed at the ticker level (2026-07 sweep, 291-ticker
    universe): ACROSS sleeves (crypto/forex/commodities) inverse-vol is
    genuine risk-parity over distinct risk classes and helps a lot (see
    compute_inter_weights). But WITHIN a sleeve, among similar tickers,
    residual vol is largely the strategy's own trend signal (more vol = more
    realized trend, not just more risk) — inverse-vol ended up overweighting
    low-vol tickers with weak edge and punishing the ones with the best
    trends. Isolated in the sweep: removing it adds ~0.7pp CAGR at equal or
    better Sharpe/Calmar and unchanged MaxDD.
    """
    w = pd.Series(0.0, index=window.columns)
    for sleeve, tickers in sleeve_to_tickers.items():
        cols = [t for t in tickers if t in window.columns]
        if not cols:
            continue
        sub     = window[cols]
        counts  = sub.count()
        active  = list(counts[counts >= MIN_OBS_WIN].index)
        if not active:
            active = list(counts[counts > 0].index)
        if not active:
            continue
        div = pd.Series({t: max(float(div_map.get(t, 0.5)), 0.1) for t in active})
        ww = div
        if ww.sum() <= 0:
            ww = pd.Series(1.0, index=active)
        ww = ww / ww.sum()
        for t in active:
            w[t] = ww[t]
    return w


def _sleeve_returns_from_intra(window, intra_weights, sleeve_of):
    """Aggregates ticker returns into sleeve-level returns using intra weights."""
    out = {}
    for sleeve in set(sleeve_of.values()):
        cols = [t for t in window.columns
                if sleeve_of.get(t) == sleeve and intra_weights.get(t, 0) > 0]
        if not cols:
            continue
        out[sleeve] = (window[cols].fillna(0.0) * intra_weights[cols]).sum(axis=1)
    return pd.DataFrame(out)


# =============================================================================
# SECTION 11 — INTER-SLEEVE WEIGHTS (Level 2 allocation)
# =============================================================================

def compute_inter_weights(sleeve_window):
    """
    Sleeve-level weights from the rolling sleeve return matrix: inverse-vol
    on a Ledoit-Wolf shrunk covariance, subject to SLEEVE_CAPS / SLEEVE_MIN.

    Alternatives tested and discarded (2026-07 sweeps, full universe):
    risk-budget with CAGR-tilted budgets, a BTC-cycle multiplier on the
    crypto sleeve, and the combination of both — each degraded Sharpe and
    MaxDD versus plain capped inverse-vol.
    """
    cols = list(sleeve_window.columns)
    if not cols:
        return pd.Series(dtype=float)
    cov = shrink_covariance(sleeve_window.fillna(0.0))
    if cov is None:
        return pd.Series(np.ones(len(cols)) / len(cols), index=cols)
    return apply_caps(inv_vol_from_cov(cov), SLEEVE_CAPS, SLEEVE_MIN)


# =============================================================================
# SECTION 12 — PORTFOLIO CONSTRUCTION ENGINE
# =============================================================================

def build_portfolio(R, sleeve_of, div_map, regime, vix,
                    use_leverage=False,
                    apply_vix_gate=False,
                    charge_costs=False,
                    cost_bps_map=None, swap_annual_map=None):
    """
    Core point-in-time portfolio construction loop.

    Parameters
    ----------
    use_leverage   : enable vol-targeting leverage (needs MAX_LEVERAGE > 1).
    apply_vix_gate : enable the VIX de-risk gate (official config: True).
    charge_costs   : charge turnover costs and daily swap (official: True;
                     the no-friction baseline pass uses False).

    Returns
    -------
        portfolio_returns  — Series of daily returns (with leverage + costs)
        base_returns       — Series of daily returns (no leverage, no costs)
        gross_series       — Series of daily gross exposure (1.0 = fully invested)
        snapshot           — dict with final weights and diagnostic counters

    Key design choices:
      - Weights are never computed on day i using day i's return (no look-ahead).
      - Transaction costs are charged on the rebalance day as realized turnover.
      - The de-risk gate uses prior-day VIX (vix_arr[i-1]).
      - Leverage target is recomputed at each rebalance using the EWMA vol
        estimated from base_returns[:i] (yesterday's data only).
    """
    dates = R.index
    n     = len(dates)
    sleeve_to_tickers = {}
    for t in R.columns:
        sleeve_to_tickers.setdefault(sleeve_of.get(t, 'SIN_SLEEVE'), []).append(t)

    regime_arr = regime.reindex(dates).ffill().fillna(0.5).values
    vix_arr    = (vix.reindex(dates).ffill().values
                  if vix is not None else np.full(n, np.nan))

    base_ret  = np.zeros(n)
    port_ret  = np.zeros(n)
    gross_arr = np.ones(n)
    vol_arr   = np.full(n, TARGET_VOL)

    ticker_weights = pd.Series(0.0, index=R.columns)
    target_gross   = 1.0

    apply_gate = apply_vix_gate and VIX_GATE and (DERISK_GATE or use_leverage)

    # Diagnostic counters for the report
    n_vix_only = 0

    # Persistent state: sleeve weights persist between rebalance days
    intra_persist  = pd.Series(0.0, index=R.columns)
    sleeve_persist = pd.Series(dtype=float)
    scores_persist = {}

    def _sleeve_freq(sleeve):
        if not PER_SLEEVE_REBAL:
            return REBAL_FREQ
        return REBAL_FREQ_SLEEVE.get(sleeve, REBAL_FREQ)

    all_sleeves  = sorted(set(sleeve_of.get(t, 'SIN_SLEEVE') for t in R.columns))
    apply_costs = APPLY_COSTS and charge_costs and (cost_bps_map is not None)
    cost_per_ticker = (np.array([cost_bps_map.get(t, COST_BPS_DEFAULT) / 1e4
                                  for t in R.columns])
                       if apply_costs else None)

    # Daily swap/financing cost (CFD holding cost, Vantage). Zero default
    # keeps this a no-op for Hapi/Binance-only tickers or when no
    # swap_annual_map is provided (e.g. the baseline pass).
    #
    # Forex (=X) uses a TIME-VARYING swap from forex_swap.py: the swap of a
    # forex pair IS the policy-rate differential, which changes with every
    # central-bank decision. A flat annual rate misrepresents it badly,
    # especially for exotics. Everything else (equity CFD, commodities)
    # keeps the flat annual rate from broker_config.py.
    apply_swap  = apply_costs and (swap_annual_map is not None)
    if apply_swap and USE_HISTORICAL_FOREX_SWAP:
        import forex_swap as FXS
        # (days × tickers) matrix of daily swap. Forex uses the historical
        # series; everything else the prorated flat rate.
        swap_daily_mat = np.zeros((n, len(R.columns)))
        for j, t in enumerate(R.columns):
            if FXS.is_forex(t):
                serie = FXS.long_swap_cost_series(t, R.index) / FREQ_ANNUAL
                swap_daily_mat[:, j] = serie.values
            else:
                swap_daily_mat[:, j] = swap_annual_map.get(t, 0.0) / FREQ_ANNUAL
        swap_daily_rate = None   # the matrix is used instead
    elif apply_swap:
        swap_daily_rate = np.array([swap_annual_map.get(t, 0.0) / FREQ_ANNUAL
                                     for t in R.columns])
        swap_daily_mat = None
    else:
        swap_daily_rate, swap_daily_mat = None, None

    total_cost      = 0.0
    total_swap_cost = 0.0
    n_rebalances = 0
    R_filled     = R.fillna(0.0)

    for i in range(n):
        # Estimate realized vol from yesterday's base returns (no look-ahead)
        rv = estimate_vol(base_ret, i)
        vol_arr[i] = rv

        # Determine today's gross exposure using yesterday's VIX
        if apply_gate:
            vix_prev = vix_arr[i - 1] if i > 0 else vix_arr[0]
            gross = compute_gross_exposure(target_gross, vix_prev, rv)
            if gross < target_gross - 1e-9:
                n_vix_only += 1
        else:
            gross = target_gross

        # Daily P&L
        daily        = float((R_filled.iloc[i] * ticker_weights).sum())
        base_ret[i]  = daily
        borrow       = (gross - 1.0) * (BORROW_RATE_ANNUAL / FREQ_ANNUAL)

        # Daily swap/financing cost: charged on EVERY day a Vantage CFD
        # position is held, proportional to its current weight — not just
        # on rebalance days. This is what a flat turnover-bps model misses.
        swap_today = 0.0
        if apply_swap:
            rates_i = (swap_daily_mat[i] if swap_daily_mat is not None
                       else swap_daily_rate)
            swap_today = float((ticker_weights.values * rates_i).sum()) * gross
            total_swap_cost += swap_today

        port_ret[i]  = gross * daily - borrow - swap_today
        gross_arr[i] = gross

        if i < WARMUP_MIN:
            continue

        # Which sleeves rebalance today? (first rebalance always at WARMUP_MIN;
        # REBAL_PHASE_OFFSET shifts the subsequent grid for phase testing)
        rebal_today = [s for s in all_sleeves
                       if i == WARMUP_MIN
                       or (i - WARMUP_MIN - REBAL_PHASE_OFFSET) % _sleeve_freq(s) == 0]
        if not rebal_today:
            continue

        window      = R.iloc[max(0, i - LOOKBACK):i]
        intra_new   = compute_intra_weights(window, sleeve_to_tickers, div_map)
        sleeve_ret  = _sleeve_returns_from_intra(window, intra_new, sleeve_of)
        if sleeve_ret.shape[1] == 0:
            continue

        sleeve_w = compute_inter_weights(sleeve_ret)
        scores = {s: sleeve_trend_score(sleeve_ret[s]) for s in sleeve_ret.columns}

        # Update only the sleeves rebalancing today; others keep their last weight
        for s in rebal_today:
            if s in sleeve_w.index:
                sleeve_persist[s] = sleeve_w[s]
            for t in R.columns:
                if sleeve_of.get(t, 'SIN_SLEEVE') == s:
                    intra_persist[t] = intra_new.get(t, 0.0)
            if s in scores:
                scores_persist[s] = scores[s]

        # Combine intra and inter weights, renormalize
        new_w = pd.Series(0.0, index=R.columns)
        for t in R.columns:
            s = sleeve_of.get(t, 'SIN_SLEEVE')
            new_w[t] = intra_persist.get(t, 0.0) * sleeve_persist.get(s, 0.0)

        if new_w.sum() > 0:
            new_w /= new_w.sum()
            if apply_costs:
                turnover    = np.abs(new_w.values - ticker_weights.values)
                cost_today  = float((turnover * cost_per_ticker).sum())
                port_ret[i] -= cost_today
                total_cost  += cost_today
                n_rebalances += 1
            ticker_weights = new_w

        target_gross = leverage_factor(regime_arr[i], rv) if use_leverage else 1.0

    snapshot = {
        'w_intra':  intra_persist.copy(),
        'w_sleeve': sleeve_persist.copy(),
        'w_ticker': ticker_weights.copy(),
        'sleeve_scores': dict(scores_persist),
        'cost_total': total_cost,
        'swap_cost_total': total_swap_cost,
        'n_rebal':    n_rebalances,
        'n_vix_only': n_vix_only,
        'rv_mean': float(np.nanmean(vol_arr[WARMUP_MIN:])) if n > WARMUP_MIN else float('nan'),
        'rv_max':  float(np.nanmax(vol_arr[WARMUP_MIN:]))  if n > WARMUP_MIN else float('nan'),
    }
    return (pd.Series(port_ret, index=dates),
            pd.Series(base_ret, index=dates),
            pd.Series(gross_arr, index=dates),
            snapshot)


# =============================================================================
# SECTION 13 — PERFORMANCE METRICS
# =============================================================================

def performance_metrics(daily_returns, start_date):
    """
    Computes annualized performance metrics from a daily return series.
    Metrics are computed on the period starting from start_date (post-warmup).
    """
    r  = daily_returns.loc[start_date:]
    eq = INIT_CASH * (1 + r).cumprod()
    years = len(r) / FREQ_ANNUAL
    cagr   = (eq.iloc[-1] / eq.iloc[0]) ** (1 / years) - 1 if years > 0 and eq.iloc[0] > 0 else 0
    sharpe = r.mean() / r.std() * np.sqrt(FREQ_ANNUAL) if r.std() > 0 else 0
    mdd    = max_drawdown(eq)
    vol    = r.std() * np.sqrt(FREQ_ANNUAL)
    calmar = cagr / abs(mdd) if mdd != 0 else 0
    return dict(cagr=cagr, sharpe=sharpe, vol=vol, mdd=mdd, calmar=calmar, equity=eq)


# =============================================================================
# SECTION 14 — SETUP HELPERS
# =============================================================================

def load_returns(base_name):
    """Loads a parquet or CSV return file. Raises if neither exists."""
    for ext in ('parquet', 'csv'):
        path = f"{base_name}.{ext}"
        if os.path.exists(path):
            return pd.read_parquet(path) if ext == 'parquet' else pd.read_csv(path)
    raise FileNotFoundError(f"Could not find {base_name}.parquet or {base_name}.csv")


def resolve_sleeves(ensemble_df):
    """
    Maps each ticker to its sleeve. Priority:
      1. sleeve_map.json explicit mapping
      2. sector_map.json → sector → sleeve lookup
      3. 'sleeve' column from the ensemble CSV
      4. 'SIN_SLEEVE' (uncategorized)
    """
    ticker_sleeve, sector_to_sleeve, ticker_sector = {}, {}, {}
    if os.path.exists(SLEEVE_MAP):
        with open(SLEEVE_MAP, encoding='utf-8') as f:
            sm = json.load(f)
        if isinstance(sm, dict):
            ticker_sleeve     = sm.get('ticker_sleeve', {})
            sector_to_sleeve  = sm.get('sector_to_sleeve', {})
    if os.path.exists('sector_map.json'):
        with open('sector_map.json', encoding='utf-8') as f:
            ticker_sector = json.load(f).get('ticker_sector', {})

    INVALID = {'', 'UNASSIGNED', 'SIN_SLEEVE', 'nan', 'None'}

    def _resolve(ticker, csv_sleeve):
        s = ticker_sleeve.get(ticker)
        if isinstance(s, str) and s.strip() and s not in INVALID:
            return s
        sec = ticker_sector.get(ticker)
        s   = sector_to_sleeve.get(sec) if sec else None
        if isinstance(s, str) and s.strip() and s not in INVALID:
            return s
        if isinstance(csv_sleeve, str) and csv_sleeve.strip() and csv_sleeve not in INVALID:
            return csv_sleeve
        return 'SIN_SLEEVE'

    csv_sleeves = dict(zip(ensemble_df['ticker'], ensemble_df['sleeve']))
    return {t: _resolve(t, csv_sleeves.get(t)) for t in ensemble_df['ticker']}


def load_return_matrix(df_ret=None):
    """
    Loads and returns the date × ticker return matrix, reindexed to business
    days if REINDEX_BDAYS=True. Centralized so that the balancer, validation
    and all sweep scripts use exactly the same grid.

    Weekend returns for crypto are compounded into the following Monday —
    no return information is lost.
    """
    if df_ret is None:
        df_ret = load_returns(INPUT_RETURNS)
    col = 'retorno' if 'retorno' in df_ret.columns else df_ret.columns[-1]
    df_ret = df_ret.copy()
    df_ret['fecha'] = pd.to_datetime(df_ret['fecha'])
    # NaN = "ticker did not exist yet" — do NOT fill globally (avoids IPO bias)
    R = df_ret.pivot_table(index='fecha', columns='ticker',
                           values=col, aggfunc='mean').sort_index()
    if REINDEX_BDAYS:
        idx = R.index
        if (idx.dayofweek >= 5).any():
            anchor = pd.DatetimeIndex([d if d.dayofweek < 5
                                       else (d + pd.offsets.BDay(1)) for d in idx])
            R = ((1 + R).groupby(anchor).prod(min_count=1) - 1).sort_index()
    return R


# =============================================================================
# SECTION 15 — MAIN
# =============================================================================

def main():
    print("=" * 70)
    print("PORTFOLIO BALANCER v2  (point-in-time, inverse-vol + caps + VIX gate)")
    print("=" * 70)

    if not os.path.exists(INPUT_ENSEMBLE):
        raise FileNotFoundError(f"Missing {INPUT_ENSEMBLE}. Run the Assembler first.")
    df_ens = pd.read_csv(INPUT_ENSEMBLE)
    print(f"✓ {INPUT_ENSEMBLE}: {len(df_ens)} ensembles")

    # --- Load and prepare data ---
    R = load_return_matrix()
    if REINDEX_BDAYS:
        print(f"✓ Reindexed to {len(R)} business days (crypto weekends compounded)")

    div_map = dict(zip(df_ens['ticker'], df_ens.get('diversification_score', 1.0)))

    # --- Broker classification & cost model (Hapi / Vantage / Binance) ---
    from broker_config import build_broker_map, excluded_tickers, broker_summary

    asset_group_of = dict(zip(df_ens['ticker'], df_ens.get('asset_group', '')))
    broker_map = build_broker_map(df_ens['ticker'], asset_group_of,
                                   include_non_hapi_as_cfd=INCLUDE_NON_HAPI_AS_CFD)

    excluded = excluded_tickers(broker_map)
    if excluded:
        print(f"⚠  {len(excluded)} tickers excluded (not covered by Hapi, "
              f"INCLUDE_NON_HAPI_AS_CFD=False): {excluded[:10]}"
              f"{' ...' if len(excluded) > 10 else ''}")

    bsummary = broker_summary(broker_map)
    print(f"✓ Broker allocation: " +
          "  ".join(f"{b}:{n}" for b, n in sorted(bsummary.items())))

    cost_map = {t: cm.turnover_bps for t, cm in broker_map.items()
                if cm.broker != 'EXCLUDED'}
    swap_map = {t: cm.swap_annual for t, cm in broker_map.items()
                if cm.broker != 'EXCLUDED'}

    # Experimental exclusions (forex exotics + commodity futures flags).
    # Centralized in experimental_exclusions() so validation.py uses the
    # same universe.
    exp_excl = experimental_exclusions(df_ens['ticker'])
    if exp_excl:
        print(f"✓ Experimental exclusions: {len(exp_excl)} tickers "
              f"{sorted(exp_excl)}")
        excluded = excluded + sorted(exp_excl)

    sleeve_of = resolve_sleeves(df_ens)
    sleeve_of = {t: s for t, s in sleeve_of.items()
                 if t in R.columns and t not in excluded}
    R, sleeve_of = apply_sleeve_exclusions(R, sleeve_of)
    if EXCLUDED_SLEEVES:
        print(f"✓ Sleeves excluded from the portfolio: {sorted(EXCLUDED_SLEEVES)} "
              f"→ universe: {len(sleeve_of)} tickers")

    uncategorized = sorted(t for t, s in sleeve_of.items() if s == 'SIN_SLEEVE')
    if uncategorized:
        print(f"⚠  {len(uncategorized)} tickers without a sleeve "
              f"(cap {SLEEVE_CAPS.get('SIN_SLEEVE', 0.05):.0%}): {uncategorized[:10]}")

    # --- Market signals ---
    print("⏳ Computing market regime (SPY/VIX/credit)...")
    regime, vix = compute_regime(R.index)
    pct_on  = float((regime > 0.55).mean()) * 100
    pct_off = float((regime < 0.45).mean()) * 100
    print(f"   Regime: risk-on {pct_on:.0f}%  risk-off {pct_off:.0f}%  "
          f"neutral {100 - pct_on - pct_off:.0f}%")

    start_date = R.index[WARMUP_MIN] if len(R.index) > WARMUP_MIN else R.index[0]

    # --- Pass 1: no-friction reference (no costs, no gate) ---
    # Used only to quantify the drag of costs/swap on the same portfolio.
    base_pr, _, _, _ = build_portfolio(
        R, sleeve_of, div_map, regime, vix,
        use_leverage=False, apply_vix_gate=False, charge_costs=False)
    metrics_base = performance_metrics(base_pr, start_date)

    # --- Pass 2: OFFICIAL portfolio (real costs + VIX gate) ---
    use_lev = MAX_LEVERAGE > 1.0
    port_pr, base_ret, gross, snap = build_portfolio(
        R, sleeve_of, div_map, regime, vix,
        use_leverage=use_lev,
        apply_vix_gate=True,
        charge_costs=True,
        cost_bps_map=cost_map, swap_annual_map=swap_map)
    metrics_over = performance_metrics(port_pr, start_date)

    port_eq  = metrics_over['equity']
    port_dd  = (port_eq - port_eq.cummax()) / port_eq.cummax()

    # --- Final weights (from last snapshot) ---
    w_intra  = snap['w_intra']  if snap['w_intra']  is not None else pd.Series(dtype=float)
    w_sleeve = snap['w_sleeve'] if snap['w_sleeve'] is not None else pd.Series(dtype=float)
    w_ticker = snap['w_ticker'] if snap['w_ticker'] is not None else pd.Series(dtype=float)

    weight_rows = [{'ticker': t, 'sleeve': sleeve_of.get(t, 'SIN_SLEEVE'),
                    'w_in_sleeve': round(float(w_intra.get(t, 0.0)), 5),
                    'w_sleeve':    round(float(w_sleeve.get(sleeve_of.get(t, ''), 0.0)), 5),
                    'w_final':     round(float(w_ticker.get(t, 0.0)), 5)}
                   for t in R.columns if t in sleeve_of]
    df_weights = pd.DataFrame(weight_rows).sort_values('w_final', ascending=False)
    df_weights.to_csv(OUTPUT_WEIGHTS, index=False)

    final_sleeve_weights = {s: float(w_sleeve.get(s, 0.0))
                            for s in sorted(set(sleeve_of.values()))}

    # --- Save outputs ---
    def _save(df, base):
        path = f"{base}.{FORMAT}"
        df.to_parquet(path, index=False) if FORMAT == 'parquet' else df.to_csv(path, index=False)
        return path

    base_eq = metrics_base['equity'].reindex(port_eq.index)
    df_port = pd.DataFrame({
        'fecha':          port_eq.index.strftime('%Y-%m-%d'),
        'equity':         port_eq.round(2).values,
        'baseline_equity': base_eq.round(2).values,
        'drawdown':        (port_dd * 100).round(3).values,
        'gross_exposure':  gross.reindex(port_eq.index).round(3).values,
    })
    eq_path = _save(df_port, OUTPUT_EQUITY)
    _save(pd.DataFrame({'fecha': regime.index.strftime('%Y-%m-%d'),
                        'regimen': regime.round(4).values}), OUTPUT_REGIME)

    # Sleeve equity curves (equal-weight, for charting only)
    sleeve_rows = []
    for s in sorted(set(sleeve_of.values())):
        cols = [t for t in R.columns if sleeve_of.get(t) == s]
        if not cols:
            continue
        eq_s = INIT_CASH * (1 + R[cols].fillna(0.0).mean(axis=1)).cumprod()
        for date, val in eq_s.round(2).items():
            sleeve_rows.append({'sleeve': s, 'fecha': date.strftime('%Y-%m-%d'),
                                'equity': float(val)})
    sl_path = _save(pd.DataFrame(sleeve_rows), OUTPUT_SLEEVES)

    # --- Report ---
    def _fmt(m):
        return (f"CAGR {m['cagr']*100:6.2f}%  Sharpe {m['sharpe']:5.2f}  "
                f"Vol {m['vol']*100:5.2f}%  MaxDD {m['mdd']*100:6.2f}%  "
                f"Calmar {m['calmar']:4.2f}")

    years = len(port_eq.loc[start_date:]) / FREQ_ANNUAL
    L = ["=" * 70, "PORTFOLIO BALANCER — REPORT", "=" * 70, "",
         f"Period: {start_date.date()} → {port_eq.index[-1].date()}  ({years:.1f} years)",
         f"Capital: ${INIT_CASH:,} → ${port_eq.iloc[-1]:,.0f}", "",
         "PERFORMANCE (no-cost reference vs official portfolio):",
         f"  No costs : {_fmt(metrics_base)}",
         f"  Official : {_fmt(metrics_over)}", "",
         "Allocation: inverse-vol across sleeves (capped) × diversification "
         "score within sleeves",
         f"Leverage: {'ON' if use_lev else 'OFF'} (max {MAX_LEVERAGE:.2f}x)"
         + ("" if use_lev else "  [tested 1.15-1.50x: monotonically worse]"),
         f"Regime: risk-on {pct_on:.0f}% / risk-off {pct_off:.0f}% of days (informational)",
         f"Gross exposure: mean {gross.loc[start_date:].mean():.2f}x  "
         f"(max {gross.max():.2f}x, min {gross.loc[start_date:].min():.2f}x)",
         f"VIX de-risk gate: {'ON' if DERISK_GATE else 'OFF'} "
         f"(floor {DERISK_FLOOR:.0%})  "
         f"days with exposure < 95%: {int((gross.loc[start_date:] < 0.95).sum())}",
         f"Vol estimator: {VOL_ESTIMATOR}"
         + (f" (λ={VOL_LAMBDA})" if VOL_ESTIMATOR == 'ewma' else "")
         + f"   Realized vol: mean {snap.get('rv_mean', 0)*100:.1f}%  "
           f"max {snap.get('rv_max', 0)*100:.1f}%",
         f"Transaction costs: {'ON' if APPLY_COSTS else 'OFF'}"
         + (f"  turnover {snap.get('cost_total', 0)*100:.2f}% over "
            f"{snap.get('n_rebal', 0)} rebalances  "
            f"(drag ~{snap.get('cost_total', 0) / max(years, 0.1) * 100:.2f}%/yr)"
            if APPLY_COSTS else ""),
         (f"Swap/financing (Vantage CFD holding): "
          f"total {snap.get('swap_cost_total', 0)*100:.2f}% of capital  "
          f"(drag ~{snap.get('swap_cost_total', 0) / max(years, 0.1) * 100:.2f}%/yr)"
          if APPLY_COSTS else ""),
         (f"Broker allocation: " +
          "  ".join(f"{b}:{n}" for b, n in sorted(bsummary.items()))
          if APPLY_COSTS else ""),
         (f"Excluded (not on Hapi, INCLUDE_NON_HAPI_AS_CFD=False): "
          f"{len(excluded)} tickers" if APPLY_COSTS and excluded else ""),
         "",
         "SLEEVE TREND SCORES (last rebalance, 0=bear 1=bull, informational):"]

    scores = snap.get('sleeve_scores') or {}
    for s in sorted(scores, key=scores.get, reverse=True):
        icon = ('🔥' if s in HIGH_BETA_SLEEVES and scores[s] > 0.6
                else '❄️' if s in HIGH_BETA_SLEEVES and scores[s] < 0.4 else '  ')
        L.append(f"  {s:22s} {scores[s]:.2f} {icon}")

    L += ["", "SLEEVE WEIGHTS (last rebalance):"]
    for s in sorted(final_sleeve_weights, key=final_sleeve_weights.get, reverse=True):
        cap = SLEEVE_CAPS.get(s)
        tag = f" (cap {cap:.0%})" if cap else ""
        L.append(f"  {s:22s} {final_sleeve_weights[s]*100:5.1f}%{tag}")

    L += ["", "TOP 15 POSITIONS (final weight):"]
    for _, row in df_weights.head(15).iterrows():
        L.append(f"  {row['ticker']:10s} {row['sleeve']:20s} {row['w_final']*100:5.2f}%")

    report = '\n'.join(L)
    with open(OUTPUT_REPORT, 'w', encoding='utf-8') as f:
        f.write(report)

    print("\n" + "=" * 70)
    print("✅ PORTFOLIO BALANCED")
    print("=" * 70)
    print(f"  No costs : {_fmt(metrics_base)}")
    print(f"  Official : {_fmt(metrics_over)}")
    print(f"  Weights  : {OUTPUT_WEIGHTS}   Equity: {eq_path}")
    print(f"  Regime   : {OUTPUT_REGIME}.{FORMAT}   Sleeves: {sl_path}")
    print(f"  Report   : {OUTPUT_REPORT}\n")


if __name__ == '__main__':
    main()
